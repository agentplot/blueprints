{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flywheel-next/statechart/scenario.schema.json",
  "title": "Flywheel scenario",
  "description": "One scenario as data (91): given this evidence, when these ticks, responses and events, then these transitions, effects and decisions. Every scenario states the requirements it satisfies by number.",
  "type": "object",
  "required": ["scenario", "title", "profiles", "satisfies", "given", "when", "then"],
  "additionalProperties": false,
  "properties": {
    "scenario": {"type": "string"},
    "title": {"type": "string"},
    "profiles": {"type": "array", "items": {"enum": ["all", "stand-in", "git-only", "tracker"]}},
    "satisfies": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 1, "description": "requirement numbers this scenario exercises"},
    "invariants": {"type": "array", "items": {"type": "string", "pattern": "^I\\d+$"}, "description": "invariants of section 7 the scenario checks"},
    "machines": {"type": "string", "description": "machines directory to load; default ../machines; contract scenarios use ./contract/lamp"},
    "given": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "objects": {"type": "array", "items": {"$ref": "#/$defs/object"}},
        "evidence": {"$ref": "#/$defs/evidence"},
        "leases": {"type": "array", "items": {"type": "object"}},
        "hosts": {"type": "array", "items": {"type": "object"}},
        "sinks": {"type": "array", "items": {"type": "object"}},
        "responses": {"type": "array", "items": {"type": "object"}},
        "register": {"type": "object", "description": "the plan's decision register: decision id -> number, and the counter"},
        "marks": {"type": "object", "description": "sink -> delivery mark"},
        "files": {"type": "object", "description": "books or built repository files the world reports"},
        "script": {"$ref": "#/$defs/script"}
      }
    },
    "when": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
    "then": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "transitions": {"type": "array", "items": {"type": "object", "required": ["object", "to"]}},
        "no_transitions": {"type": "array", "items": {"type": "string"}},
        "effects": {"type": "array", "items": {"type": "object", "required": ["do", "count"]}},
        "effects_closed": {"type": "boolean"},
        "decisions": {"type": "array", "items": {"type": "object", "properties": {"after_step": {"type": "integer"}, "present": {"type": "array"}, "absent": {"type": "array"}, "count": {"type": "integer"}, "tail": {"type": "array"}, "numbers": {"type": "object"}}}},
        "states": {"type": "object", "additionalProperties": {"type": "object"}},
        "records": {"type": "object"},
        "applied_responses": {"type": "object"},
        "writes": {"type": "object"},
        "reports": {"type": "array", "items": {"type": "string"}},
        "leases": {"type": "object"},
        "status": {"type": "object"},
        "control_plane": {"type": "object", "description": "assertions on the profile's own behavior (rejections, ids, as-of)"}
      }
    }
  },
  "$defs": {
    "object": {"type": "object", "required": ["id", "machine", "state"], "properties": {"id": {"type": "string"}, "machine": {"type": "string"}, "parent": {"type": "string"}, "state": {"type": "object"}, "record": {"type": "object"}, "applied_responses": {"type": "array"}}},
    "evidence": {"type": "object", "additionalProperties": {"type": "object"}, "description": "evidence name -> {object id -> value}; '*' for every object"},
    "script": {
      "type": "object",
      "description": "what the stand-in session binding plays, per session id (90): the exits and offers a real session would report through the command, and the pane and activity the multiplexer would show. Only the session binding is faked; every other binding is real.",
      "additionalProperties": {"type": "array", "items": {"type": "object", "properties": {
        "after": {"type": "string", "description": "a delay from the session's start (30s, 2m) or the step number to play at"},
        "pane": {"enum": ["present", "absent"]},
        "activity": {"enum": ["working", "idle"]},
        "keystroke": {"type": "boolean", "description": "the operator typed in the pane"},
        "exit": {"enum": ["done", "blocked", "stalled", "invalid"]},
        "deliverables": {"type": "array"},
        "question": {"type": "string"},
        "offers": {"type": "array", "items": {"type": "object", "required": ["kind", "document"]}},
        "refusal": {"type": "string"},
        "commits": {"type": "array", "description": "files the session commits in its place"}
      }}}
    },
    "step": {"type": "object", "minProperties": 1, "maxProperties": 1, "properties": {
      "tick": {"type": "object"},
      "response": {"type": "object", "required": ["answer", "id"], "properties": {"decision": {"type": "string", "description": "<object id>/<decision kind>, resolved through the register to its number"}, "number": {"type": "integer"}, "object": {"type": "string", "description": "for a dictation: the object it names"}, "answer": {"type": "string"}, "id": {"type": "string"}, "by": {"type": "string"}}},
      "evidence": {"$ref": "#/$defs/evidence"},
      "notify": {"type": "object"},
      "restart": {"type": "object"},
      "disconnect": {"type": "object"},
      "reconnect": {"type": "object"},
      "host": {"type": "object", "required": ["name"], "description": "the following steps run as this host until the next host step"},
      "clock": {"type": "object", "required": ["advance"]},
      "direct": {"type": "object", "description": "the operator acts on the store directly: a commit, a board move, an issue close"},
      "files": {"type": "object"},
      "script": {"$ref": "#/$defs/script", "description": "seed or extend the stand-in's script mid-scenario"}
    }}
  }
}
